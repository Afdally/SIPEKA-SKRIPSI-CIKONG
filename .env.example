
LLM_PROVIDER=gemini
LLM_API_KEY=

LLM_MODEL=gemini-2.5-flash

# Ganti kalau memakai penyedia lain yang bergaya OpenAI:
#   Groq       -> https://api.groq.com/openai/v1
#   OpenRouter -> https://openrouter.ai/api/v1
#   xAI (Grok) -> https://api.x.ai/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

LLM_TIMEOUT_MS=20000

# xAI / Grok. Dipakai ketika LLM_PROVIDER=grok.
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_MS=20000


OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=45000
OLLAMA_KEEP_ALIVE=10m

# Zona waktu kalender untuk frasa seperti "hari ini" dan "kemarin".
APP_TIMEZONE=Asia/Makassar

# Notifikasi email laporan yang belum diregistrasi.
# Gunakan nilai acak panjang yang sama pada Reporting Service dan Case Service.
INTERNAL_API_KEY=ganti-dengan-kunci-internal-yang-kuat
EMAIL_REMINDER_AFTER_MINUTES=30
EMAIL_REMINDER_LEASE_MINUTES=15
EMAIL_REMINDER_POLL_MINUTES=5
PETUGAS_DASHBOARD_URL=http://localhost

# Worker otomatis nonaktif bila konfigurasi berikut belum lengkap.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SIPEKA <noreply@example.go.id>
