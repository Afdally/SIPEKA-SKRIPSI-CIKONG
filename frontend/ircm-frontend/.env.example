# Alamat satu-satunya yang dipakai server frontend untuk mencapai backend.
# Isi dengan IP/domain mesin yang menjalankan API Gateway.
API_GATEWAY_TARGET=http://localhost:8080

# Opsional: gunakan hanya jika browser harus memanggil gateway secara langsung.
# Nilainya wajib berakhir dengan /api dan gateway harus mengizinkan CORS.
# VITE_API_GATEWAY_URL=http://192.168.1.10:8080/api
